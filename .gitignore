# Godot generated files
.godot/
.test_appdata/
*.tmp

# Local exports and runtime logs
builds/*
!builds/.gdignore
artifacts/*
!artifacts/.gdignore
logs/
Notes/*.apk

# Local Android signing material (the shared test key lives in GitHub Actions secrets)
android/*.keystore

# Editor / OS noise
.idea/
.vscode/
.DS_Store
Thumbs.db

# Proprietary study material: keep local and outside version control.
References/*
!References/.gdignore
internal_reference_assets/

# Local visual-direction drafts are review artifacts, never runtime content.
art_drafts/

# Backend secrets, dependencies, generated runtime and local database state
backend/.env
backend/.env.staging
backend/node_modules/
backend/build/
backend/data/
backend/backups/
