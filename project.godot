; Engine configuration file.
; Prefer editing from the Godot editor when possible.

config_version=5

[application]

boot_splash/bg_color=Color(0.0078, 0.0157, 0.051, 1)
boot_splash/image="res://assets/boot_splash.png"
boot_splash/show_image=true
boot_splash/stretch_mode=1
boot_splash/use_filter=true
config/name="Crooked Galaxy"
config/description="Comedic sci-fi idle RPG about building an interstellar bounty-hunting career."
config/version="0.31.2"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://assets/icon.svg"
config/quit_on_go_back=false

[autoload]

GameState="*res://scripts/game_state.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=450
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.025, 0.035, 0.08, 1)

[gui]

theme/default_font_multichannel_signed_distance_field=true

[internationalization]

locale/translations=PackedStringArray("res://locales/crooked.en.po", "res://locales/crooked.pt.po")
